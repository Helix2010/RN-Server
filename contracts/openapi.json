{
  "openapi": "3.0.3",
  "info": {
    "title": "RN Server Foundation API",
    "version": "2026.08.26"
  },
  "paths": {
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Live"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/v1/admin/app-config": {
      "get": {
        "responses": {
          "200": {
            "description": "App config (config.wallet holds the WalletConnect project id and per-chain endpoints; metadata.walletCatalog lists the chains this platform supports)"
          }
        }
      },
      "patch": {
        "responses": {
          "200": {
            "description": "Saved app config (a request without config.wallet keeps the stored wallet section)"
          },
          "400": {
            "description": "INVALID_APP_CONFIG or INVALID_WALLET_CONFIG"
          }
        }
      }
    },
    "/v1/admin/audit-events": {
      "get": {
        "responses": {
          "200": {
            "description": "Audit events"
          }
        }
      }
    },
    "/v1/admin/auth/login": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated"
          }
        }
      }
    },
    "/v1/admin/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/v1/admin/auth/session": {
      "get": {
        "responses": {
          "200": {
            "description": "Session"
          }
        }
      }
    },
    "/v1/admin/branding": {
      "get": {
        "responses": {
          "200": {
            "description": "Branding configuration"
          }
        }
      },
      "patch": {
        "responses": {
          "200": {
            "description": "Saved branding configuration"
          },
          "409": {
            "description": "Stale branding configuration"
          }
        }
      }
    },
    "/v1/admin/branding/assets/upload": {
      "put": {
        "responses": {
          "200": {
            "description": "Temporary branding asset stored"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Temporary branding asset removed"
          }
        }
      }
    },
    "/v1/admin/branding/assets/uploads": {
      "post": {
        "responses": {
          "201": {
            "description": "Temporary branding asset upload ticket"
          }
        }
      }
    },
    "/v1/admin/installations": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant installation list"
          }
        }
      }
    },
    "/v1/admin/installations/overview": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant installation and active version overview"
          }
        }
      }
    },
    "/v1/admin/installations/{id}/revoke": {
      "post": {
        "responses": {
          "200": {
            "description": "Installation revoked"
          }
        }
      }
    },
    "/v1/admin/localization": {
      "get": {
        "responses": {
          "200": {
            "description": "Effective localization settings and documents"
          }
        }
      }
    },
    "/v1/admin/localization/documents": {
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalizationDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved tenant language documents"
          },
          "409": {
            "description": "Localization key already exists"
          },
          "422": {
            "description": "Invalid localization document"
          }
        }
      }
    },
    "/v1/admin/localization/languages": {
      "put": {
        "responses": {
          "200": {
            "description": "Saved tenant language overrides"
          }
        }
      }
    },
    "/v1/admin/localization/publish": {
      "post": {
        "responses": {
          "200": {
            "description": "Published localization resources"
          }
        }
      }
    },
    "/v1/admin/ota/artifacts/upload": {
      "put": {
        "responses": {
          "200": {
            "description": "Temporary OTA package stored"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Temporary OTA package removed"
          }
        }
      }
    },
    "/v1/admin/ota/artifacts/uploads": {
      "post": {
        "responses": {
          "201": {
            "description": "Temporary OTA upload ticket"
          }
        }
      }
    },
    "/v1/admin/ota/base-releases": {
      "get": {
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "android",
                "ios"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified APK releases available as OTA bases"
          }
        }
      }
    },
    "/v1/admin/ota/releases": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant OTA release list"
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OTAReleaseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Verified OTA release created"
          },
          "422": {
            "description": "Base release or apply strategy invalid"
          }
        }
      }
    },
    "/v1/admin/ota/releases/{id}": {
      "get": {
        "responses": {
          "200": {
            "description": "OTA release detail with final Manifest identity"
          }
        }
      }
    },
    "/v1/admin/ota/releases/{id}/{action}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReleaseId"
        },
        {
          "name": "action",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "publish",
              "pause",
              "rollback"
            ]
          }
        }
      ],
      "post": {
        "responses": {
          "201": {
            "description": "OTA state transition or rollback directive"
          }
        }
      }
    },
    "/v1/admin/overview": {
      "get": {
        "responses": {
          "200": {
            "description": "Release overview"
          }
        }
      }
    },
    "/v1/admin/push/deliveries": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant push delivery details"
          }
        }
      }
    },
    "/v1/admin/push/outbox": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant push outbox events"
          }
        }
      }
    },
    "/v1/admin/release-artifacts/upload": {
      "put": {
        "responses": {
          "200": {
            "description": "Temporary artifact stored"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Temporary artifact removed"
          }
        }
      }
    },
    "/v1/admin/release-artifacts/uploads": {
      "post": {
        "responses": {
          "201": {
            "description": "Temporary artifact upload ticket"
          }
        }
      }
    },
    "/v1/admin/release-storage": {
      "get": {
        "responses": {
          "200": {
            "description": "Masked release storage config"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Saved release storage config"
          }
        }
      }
    },
    "/v1/admin/release-storage/test": {
      "post": {
        "responses": {
          "200": {
            "description": "Storage test result"
          }
        }
      }
    },
    "/v1/admin/releases": {
      "get": {
        "responses": {
          "200": {
            "description": "Release list"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Verified release created from uploaded artifact (mandatory=true makes the update unskippable once this release is active)"
          }
        }
      }
    },
    "/v1/admin/releases/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReleaseId"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Release detail"
          }
        }
      }
    },
    "/v1/admin/releases/{id}/{action}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReleaseId"
        },
        {
          "name": "action",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "publish",
              "pause"
            ]
          }
        }
      ],
      "post": {
        "responses": {
          "201": {
            "description": "Transitioned release"
          }
        }
      }
    },
    "/v1/admin/tenant": {
      "get": {
        "responses": {
          "200": {
            "description": "Current tenant"
          }
        }
      }
    },
    "/v1/admin/upload-sessions": {
      "post": {
        "summary": "Create resumable multipart upload session",
        "responses": {
          "201": {
            "description": "Upload session created"
          },
          "422": {
            "description": "Invalid upload session"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadSessionRequest"
              }
            }
          }
        }
      }
    },
    "/v1/admin/upload-sessions/cleanup-expired": {
      "post": {
        "responses": {
          "200": {
            "description": "Expired sessions aborted"
          }
        }
      }
    },
    "/v1/admin/upload-sessions/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UploadSessionId"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Upload session and uploaded parts"
          },
          "401": {
            "description": "Invalid session token"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/UploadSessionToken"
          }
        ]
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Upload session cancelled"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/UploadSessionToken"
          }
        ]
      }
    },
    "/v1/admin/upload-sessions/{id}/complete": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UploadSessionId"
        }
      ],
      "post": {
        "parameters": [
          {
            "$ref": "#/components/parameters/UploadSessionToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadSessionCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed artifact token"
          }
        }
      }
    },
    "/v1/admin/upload-sessions/{id}/parts/{partNumber}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UploadSessionId"
        },
        {
          "name": "partNumber",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "put": {
        "parameters": [
          {
            "$ref": "#/components/parameters/UploadSessionToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {}
          }
        },
        "responses": {
          "200": {
            "description": "Part uploaded"
          }
        }
      }
    },
    "/v1/admin/upload-sessions/{id}/parts/{partNumber}/presign": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UploadSessionId"
        },
        {
          "name": "partNumber",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "parameters": [
          {
            "$ref": "#/components/parameters/UploadSessionToken"
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned part URL"
          }
        }
      }
    },
    "/v1/mobile/auth/logout": {
      "post": {
        "summary": "Revoke the current wallet session",
        "responses": {
          "200": {
            "description": "Signed out"
          }
        }
      }
    },
    "/v1/mobile/auth/nonce": {
      "post": {
        "summary": "Issue a SIWE challenge for a wallet address",
        "responses": {
          "200": {
            "description": "SIWE nonce and message"
          }
        }
      }
    },
    "/v1/mobile/auth/session": {
      "get": {
        "summary": "Read the current wallet session",
        "responses": {
          "200": {
            "description": "Wallet session"
          },
          "401": {
            "description": "Session missing or revoked"
          }
        }
      }
    },
    "/v1/mobile/auth/verify": {
      "post": {
        "summary": "Exchange a SIWE signature for a session token",
        "responses": {
          "200": {
            "description": "Wallet session"
          }
        }
      }
    },
    "/v1/mobile/bootstrap": {
      "get": {
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bootstrap config; update.decision is none|recommended|required, where required comes from updatePolicy.minSupportedVersion or from a mandatory active release"
          }
        }
      }
    },
    "/v1/mobile/branding/assets/{id}": {
      "get": {
        "responses": {
          "200": {
            "description": "Branding asset"
          },
          "404": {
            "description": "Branding asset not found"
          }
        }
      }
    },
    "/v1/mobile/installations/heartbeat": {
      "post": {
        "responses": {
          "200": {
            "description": "Installation heartbeat accepted"
          }
        }
      }
    },
    "/v1/mobile/installations/register": {
      "post": {
        "responses": {
          "201": {
            "description": "Installation registered"
          }
        }
      }
    },
    "/v1/mobile/languages/{languageCode}/document": {
      "parameters": [
        {
          "name": "languageCode",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Published localization JSON"
          },
          "304": {
            "description": "Not modified"
          }
        }
      }
    },
    "/v1/mobile/push-tokens": {
      "post": {
        "responses": {
          "200": {
            "description": "Push token registered"
          }
        }
      }
    },
    "/v1/ota/assets/{id}/{path}": {
      "get": {
        "responses": {
          "200": {
            "description": "Immutable OTA asset"
          },
          "404": {
            "description": "Asset not found"
          }
        }
      }
    },
    "/v1/ota/manifest": {
      "get": {
        "responses": {
          "200": {
            "description": "Expo Updates manifest"
          },
          "204": {
            "description": "No matching update"
          }
        }
      }
    },
    "/v1/public/releases/latest": {
      "get": {
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "android",
                "ios",
                "harmony"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest active release"
          }
        }
      }
    },
    "/v1/public/releases/{id}/download": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReleaseId"
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "Release package stream"
          },
          "404": {
            "description": "Published release not found"
          },
          "502": {
            "description": "Release package unavailable"
          },
          "503": {
            "description": "Release storage unavailable"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ReleaseId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "UploadSessionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "UploadSessionToken": {
        "name": "x-upload-session-token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LocalizationDocumentsRequest": {
        "type": "object",
        "required": [
          "documents",
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 3
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/LocalizationDocumentChange"
            }
          }
        }
      },
      "OTAReleaseRequest": {
        "type": "object",
        "required": [
          "artifactToken",
          "baseReleaseId",
          "channel"
        ],
        "properties": {
          "artifactToken": {
            "type": "string"
          },
          "baseReleaseId": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "applyStrategy": {
            "type": "string",
            "enum": [
              "next_launch",
              "immediate"
            ],
            "default": "next_launch"
          },
          "sourceCommitSha": {
            "type": "string"
          },
          "releaseNotes": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "LocalizationDocumentChange": {
        "type": "object",
        "required": [
          "key",
          "meta",
          "values"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$",
            "description": "Canonical lowercase localization key"
          },
          "meta": {
            "type": "string",
            "maxLength": 255
          },
          "create": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean",
            "description": "Maps to language_document.deleted for the whole key"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "nullable": true
            }
          }
        }
      },
      "UploadSessionRequest": {
        "type": "object",
        "required": [
          "uploadType",
          "fileName",
          "size"
        ],
        "properties": {
          "uploadType": {
            "type": "string",
            "enum": [
              "apk",
              "ota"
            ]
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "partSize": {
            "type": "integer",
            "minimum": 5242880,
            "maximum": 536870912
          }
        }
      },
      "UploadSessionPart": {
        "type": "object",
        "required": [
          "partNumber",
          "etag",
          "size"
        ],
        "properties": {
          "partNumber": {
            "type": "integer",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "UploadSessionCompleteRequest": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/UploadSessionPart"
            }
          }
        }
      },
      "OTAManifestIdentity": {
        "type": "object",
        "additionalProperties": true
      },
      "OTAReleaseDetail": {
        "type": "object",
        "required": [
          "release",
          "identity",
          "baseMetadata",
          "manifest"
        ],
        "properties": {
          "release": {
            "$ref": "#/components/schemas/OTARelease"
          },
          "identity": {
            "$ref": "#/components/schemas/OTAManifestIdentity"
          },
          "baseMetadata": {
            "type": "object",
            "additionalProperties": true
          },
          "manifest": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          }
        }
      }
    }
  }
}
