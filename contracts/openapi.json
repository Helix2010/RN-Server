{
  "openapi": "3.0.3",
  "info": {"title": "RN Server Foundation API", "version": "2026.08.26"},
  "paths": {
    "/health/live": {"get": {"responses": {"200": {"description": "Live"}}}},
    "/health/ready": {"get": {"responses": {"200": {"description": "Ready"}, "503": {"description": "Unavailable"}}}},
    "/v1/mobile/bootstrap": {"get": {"parameters": [{"name": "locale", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Bootstrap configuration"}}}},
    "/v1/mobile/languages/{languageCode}/document": {"parameters": [{"name": "languageCode", "in": "path", "required": true, "schema": {"type": "string"}}], "get": {"responses": {"200": {"description": "Published localization JSON"}, "304": {"description": "Not modified"}}}},
    "/v1/admin/auth/login": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"200": {"description": "Authenticated"}}}},
    "/v1/admin/auth/session": {"get": {"responses": {"200": {"description": "Session"}}}},
    "/v1/admin/auth/logout": {"post": {"responses": {"200": {"description": "Logged out"}}}},
    "/v1/admin/tenant": {"get": {"responses": {"200": {"description": "Current tenant"}}}},
    "/v1/admin/overview": {"get": {"responses": {"200": {"description": "Release overview"}}}},
    "/v1/admin/releases": {"get": {"responses": {"200": {"description": "Release list"}}}, "post": {"responses": {"201": {"description": "Verified release created from uploaded artifact"}}}},
    "/v1/admin/release-artifacts/uploads": {"post": {"responses": {"201": {"description": "Temporary artifact upload ticket"}}}},
    "/v1/admin/release-artifacts/upload": {"put": {"responses": {"200": {"description": "Temporary artifact stored"}}}, "delete": {"responses": {"200": {"description": "Temporary artifact removed"}}}},
    "/v1/admin/ota/base-releases": {"get": {"parameters": [{"name": "platform", "in": "query", "schema": {"type": "string", "enum": ["android", "ios"]}}], "responses": {"200": {"description": "Verified APK releases available as OTA bases"}}}},
    "/v1/admin/ota/releases": {"get": {"responses": {"200": {"description": "Tenant OTA release list"}}}, "post": {"responses": {"201": {"description": "Verified OTA release created"}}}},
    "/v1/admin/ota/artifacts/uploads": {"post": {"responses": {"201": {"description": "Temporary OTA upload ticket"}}}},
    "/v1/admin/ota/artifacts/upload": {"put": {"responses": {"200": {"description": "Temporary OTA package stored"}}}, "delete": {"responses": {"200": {"description": "Temporary OTA package removed"}}}},
    "/v1/admin/ota/releases/{id}/{action}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"name": "action", "in": "path", "required": true, "schema": {"type": "string", "enum": ["publish", "pause", "rollback"]}}], "post": {"responses": {"201": {"description": "OTA state transition or rollback directive"}}}},
    "/v1/ota/manifest": {"get": {"responses": {"200": {"description": "Expo Updates manifest"}, "204": {"description": "No matching update"}}}},
    "/v1/ota/assets/{id}/{path}": {"get": {"responses": {"200": {"description": "Immutable OTA asset"}, "404": {"description": "Asset not found"}}}},
    "/v1/admin/releases/{id}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"responses": {"200": {"description": "Release detail"}}}},
    "/v1/admin/releases/{id}/{action}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"name": "action", "in": "path", "required": true, "schema": {"type": "string", "enum": ["publish", "pause"]}}], "post": {"responses": {"201": {"description": "Transitioned release"}}}},
    "/v1/admin/app-config": {"get": {"responses": {"200": {"description": "App config"}}}, "patch": {"responses": {"200": {"description": "Saved app config"}}}},
    "/v1/admin/localization": {"get": {"responses": {"200": {"description": "Effective localization settings and documents"}}}},
    "/v1/admin/localization/languages": {"put": {"responses": {"200": {"description": "Saved tenant language overrides"}}}},
    "/v1/admin/localization/documents": {"put": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LocalizationDocumentsRequest"}}}}, "responses": {"200": {"description": "Saved tenant language documents"}, "409": {"description": "Localization key already exists"}, "422": {"description": "Invalid localization document"}}}},
    "/v1/admin/localization/publish": {"post": {"responses": {"200": {"description": "Published localization resources"}}}},
    "/v1/admin/release-storage": {"get": {"responses": {"200": {"description": "Masked release storage config"}}}, "put": {"responses": {"200": {"description": "Saved release storage config"}}}},
    "/v1/admin/release-storage/test": {"post": {"responses": {"200": {"description": "Storage test result"}}}},
    "/v1/admin/audit-events": {"get": {"responses": {"200": {"description": "Audit events"}}}},
    "/v1/public/releases/latest": {"get": {"parameters": [{"name": "platform", "in": "query", "required": true, "schema": {"type": "string", "enum": ["android", "ios", "harmony"]}}], "responses": {"200": {"description": "Latest active release"}}}},
    "/v1/public/releases/{id}/download": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"responses": {"200": {"description": "Release package stream"}, "404": {"description": "Published release not found"}, "502": {"description": "Release package unavailable"}, "503": {"description": "Release storage unavailable"}}}}
  },
  "components": {
    "parameters": {"ReleaseId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}},
    "schemas": {
      "LoginRequest": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password"}}},
      "LocalizationDocumentsRequest": {"type": "object", "required": ["documents", "reason"], "properties": {"reason": {"type": "string", "minLength": 3}, "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/LocalizationDocumentChange"}}}},
      "LocalizationDocumentChange": {"type": "object", "required": ["key", "meta", "values"], "properties": {"key": {"type": "string", "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$", "description": "Canonical lowercase localization key"}, "meta": {"type": "string", "maxLength": 255}, "create": {"type": "boolean"}, "enabled": {"type": "boolean", "description": "Maps to language_document.deleted for the whole key"}, "values": {"type": "object", "additionalProperties": {"type": "string", "nullable": true}}}}
    }
  }
}
