{
  "openapi": "3.0.3",
  "info": {"title": "RN Server Foundation API", "version": "2026.08.25"},
  "paths": {
    "/health/live": {"get": {"responses": {"200": {"description": "Live"}}}},
    "/health/ready": {"get": {"responses": {"200": {"description": "Ready"}, "503": {"description": "Unavailable"}}}},
    "/v1/mobile/bootstrap": {"get": {"parameters": [{"name": "locale", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Bootstrap configuration"}}}},
    "/v1/admin/auth/login": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"200": {"description": "Authenticated"}}}},
    "/v1/admin/auth/session": {"get": {"responses": {"200": {"description": "Session"}}}},
    "/v1/admin/auth/logout": {"post": {"responses": {"200": {"description": "Logged out"}}}},
    "/v1/admin/tenant": {"get": {"responses": {"200": {"description": "Current tenant"}}}},
    "/v1/admin/overview": {"get": {"responses": {"200": {"description": "Release overview"}}}},
    "/v1/admin/releases": {"get": {"responses": {"200": {"description": "Release list"}}}},
    "/v1/admin/releases/uploads": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReleaseUploadRequest"}}}}, "responses": {"201": {"description": "Upload ticket"}}}},
    "/v1/admin/releases/{id}/upload": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "put": {"requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "responses": {"200": {"description": "Release package stored by RN-Server"}}}},
    "/v1/admin/releases/{id}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"responses": {"200": {"description": "Release detail"}}}},
    "/v1/admin/releases/{id}/finalize": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "post": {"responses": {"200": {"description": "Verified release"}}}},
    "/v1/admin/releases/{id}/{action}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"name": "action", "in": "path", "required": true, "schema": {"type": "string", "enum": ["publish", "pause", "rollback"]}}], "post": {"responses": {"201": {"description": "Transitioned release"}}}},
    "/v1/admin/app-config": {"get": {"responses": {"200": {"description": "App config"}}}, "patch": {"responses": {"200": {"description": "Saved app config"}}}},
    "/v1/admin/release-storage": {"get": {"responses": {"200": {"description": "Masked release storage config"}}}, "put": {"responses": {"200": {"description": "Saved release storage config"}}}},
    "/v1/admin/release-storage/test": {"post": {"responses": {"200": {"description": "Storage test result"}}}},
    "/v1/admin/audit-events": {"get": {"responses": {"200": {"description": "Audit events"}}}},
    "/v1/public/releases/latest": {"get": {"parameters": [{"name": "platform", "in": "query", "required": true, "schema": {"type": "string", "enum": ["android", "ios", "harmony"]}}], "responses": {"200": {"description": "Latest active release"}}}},
    "/v1/public/releases/{id}/download": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"responses": {"200": {"description": "Release package stream"}, "404": {"description": "Published release not found"}, "502": {"description": "Release package unavailable"}, "503": {"description": "Release storage unavailable"}}}}
  },
  "components": {
    "parameters": {"ReleaseId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}},
    "schemas": {
      "LoginRequest": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password"}}},
      "ReleaseUploadRequest": {"type": "object", "required": ["platform", "version", "buildNumber", "runtimeVersion", "fileName", "contentType", "size"], "properties": {"platform": {"type": "string", "enum": ["android", "ios", "harmony"]}, "version": {"type": "string"}, "buildNumber": {"type": "integer", "minimum": 1}, "runtimeVersion": {"type": "string"}, "releaseNotes": {"type": "object"}, "fileName": {"type": "string"}, "contentType": {"type": "string"}, "size": {"type": "integer", "minimum": 1}}}
    }
  }
}
