PORT=3000
HTTP_READ_TIMEOUT_SECONDS=3600
HTTP_WRITE_TIMEOUT_SECONDS=3600
CORS_ORIGINS=*
ANDROID_STORE_URL=
ANDROID_DIRECT_URL=
IOS_STORE_URL=
IOS_MDM_URL=
OTA_CHANNEL=production
ADMIN_API_KEY=local-development-admin-key-please-change
ADMIN_USERNAME=local-admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rn_foundation
MYSQL_CONNECTION_LIMIT=10
MYSQL_MAX_IDLE_CONNECTIONS=2
MYSQL_CONNECTION_MAX_LIFETIME_SECONDS=1800
MYSQL_CONNECTION_MAX_IDLE_TIME_SECONDS=300
MYSQL_QUERY_TIMEOUT_SECONDS=10
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=Z
MYSQL_PARSE_TIME=true
MYSQL_CONNECT_TIMEOUT_SECONDS=15
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_WRITE_TIMEOUT_SECONDS=30
MYSQL_INIT_TIMEOUT_SECONDS=30
MYSQL_INIT_MAX_ATTEMPTS=3
MYSQL_INIT_RETRY_DELAY_SECONDS=5
MYSQL_AUTO_MIGRATE=true
STORAGE_MASTER_KEY=
# Optional separate 32-byte base64 HMAC key for cross-app device grouping.
# When empty, STORAGE_MASTER_KEY is used.
DEVICE_IDENTITY_HMAC_KEY=
PUSH_DISPATCH_ENABLED=false
PUSH_POLL_INTERVAL_SECONDS=10
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=production
ARTIFACT_MAX_SIZE_MB=512
# direct = browser uploads to S3/OBS and needs bucket CORS; proxy = RN-Server streams the file to storage.
ARTIFACT_UPLOAD_MODE=direct
ARTIFACT_UPLOAD_TTL_SECONDS=900
# Multipart sessions remain resumable for this duration; completed artifacts receive the shorter upload TTL above.
ARTIFACT_MULTIPART_TTL_SECONDS=7200
ARTIFACT_DOWNLOAD_TTL_SECONDS=300
ARTIFACT_VERIFY_TIMEOUT_SECONDS=300
