# 本地开发的最小配置。
#
# 原则：.env 只放"别处不可能知道"的东西——机密与这台机器的拓扑。有默认值的键不写，
# 能从库里推导的不填，按租户变化的进租户配置。写一行等于默认值的配置，代价是以后
# 没人知道它是"特意设成这样"还是"当年抄过来的"。
#
# 全部可用的键、默认值、以及什么时候需要改，见 docs/CONFIGURATION.md；
# 这台机器上实际生效的是什么，跑 `rn-server config`。

APP_ENV=development

# ---- 数据库 ----
# 一行 DSN，格式是 go-sql-driver 的标准写法：user:password@tcp(host:port)/database?params
# 口令里含 @ / : & $ 都不用转义（驱动取最后一个 @ 作分隔），但**用户名**不能含 ':'。
# 没写的参数服务端会补成我们的默认值（parseTime、三个超时、charset），补了什么
# `rn-server config` 会逐项列出——驱动自己的默认值和我们的不一样，parseTime 默认
# false 会让每个读时间的接口 500，而启动是绿的。
#
# 注意：下面这行**必须**带单引号。用 `set -a && source .env` 加载时，值里的 ( ) &
# 都会被 shell 解释——不加引号会直接报 syntax error near unexpected token `('
MYSQL_DSN='root:@tcp(127.0.0.1:3306)/rn_foundation?parseTime=true&loc=UTC&charset=utf8mb4'
# 本地库随便建随便删，所以开着自动迁移；生产上是 false，迁移由单独的 unit 跑
MYSQL_AUTO_MIGRATE=true

# ---- 机密 ----
# 32 字节 base64。库里所有敏感配置（对象存储凭据、OTA 签名私钥、推送服务账号、
# 签名密钥外层）都用它封。换掉它 = 那些配置全部解不开。
STORAGE_MASTER_KEY=
ADMIN_USERNAME=local-admin
# 用 `rn-server` 起来之后调 /v1/admin/platform/password-hash 生成，或问同事要一个
ADMIN_PASSWORD_HASH=
ADMIN_API_KEY=local-development-admin-key-please-change
# 打包机代理的凭据，与管理端**完全分开**：管理端密钥能改配置、能发版、能读安装明细，
# 而打包机只需要认领任务和回报结果。留空则 /v1/build-agent 整条通道关闭。
BUILD_AGENT_TOKEN=

# ---- 本地才需要的覆盖 ----
# 管理会话 cookie 默认只走 TLS；本地用 http 调管理端才要关掉
ADMIN_COOKIE_SECURE=false

# ---- 下面这些平时不用写，列在这里是因为本地偶尔要开 ----
# 推送派发。凭据**不在这里**：按租户存在库里（app_configs 的 push.fcm），
# 在管理端「Android 打包与签名」页配。见 docs/decisions/0017-per-tenant-push-credentials.md
# PUSH_DISPATCH_ENABLED=false
# 扫链进程（`rn-server indexer`）；私网部署允许 http 端点用 INDEXER_ALLOW_PLAIN_HTTP
# INDEXER_ENABLED=false
# 平台级页面（扫链管理、打包机公钥、平台推送默认）的准入名单，逗号分隔
# PLATFORM_ADMIN_USERNAMES=local-admin
# direct = 浏览器直传对象存储，需要桶上有 CORS 规则；proxy = 服务端代传
# ARTIFACT_UPLOAD_MODE=direct
# 额外放行的跨域来源。租户自己的域名由 tenant_domain 表推导，不用写在这里；
# 开发环境不填等于 "*"，生产环境不填等于"只认租户域名"
# CORS_ORIGINS=
