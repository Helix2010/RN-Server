SERVER_PORT=3100
ADMIN_PORT=3180
HTTP_READ_TIMEOUT_SECONDS=3600
HTTP_WRITE_TIMEOUT_SECONDS=3600
PUBLIC_BASE_DOMAIN=anyfun.win
PUBLIC_CONSOLE_DOMAIN=console.anyfun.win
PUBLIC_API_DOMAIN=api.anyfun.win
PUBLIC_SERVER_URL=https://api.anyfun.win
CORS_ORIGINS=https://console.anyfun.win
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_API_TOKEN

ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY
ADMIN_API_ACTOR=api-key-automation
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=true

# 一行 DSN（2026-09-13 起旧的十一个 MYSQL_* 键已经不再被读取）。回滚到这台机器时
# 直接把 amos 的 /etc/rn-foundation.env 里那一行照抄过来。
MYSQL_DSN=CHANGE_ME_USER:CHANGE_ME_PASSWORD@tcp(CHANGE_ME_HOST:3306)/CHANGE_ME_DATABASE?parseTime=true&loc=UTC&charset=utf8mb4&timeout=15s&readTimeout=15s&writeTimeout=15s
MYSQL_CONNECTION_LIMIT=3
MYSQL_MAX_IDLE_CONNECTIONS=1
MYSQL_CONNECTION_MAX_LIFETIME_SECONDS=600
MYSQL_CONNECTION_MAX_IDLE_TIME_SECONDS=60
MYSQL_QUERY_TIMEOUT_SECONDS=10
MYSQL_INIT_TIMEOUT_SECONDS=30
MYSQL_INIT_MAX_ATTEMPTS=3
MYSQL_INIT_RETRY_DELAY_SECONDS=5
MYSQL_AUTO_MIGRATE=false

# Generate with: openssl rand -base64 32
STORAGE_MASTER_KEY=CHANGE_ME_STORAGE_MASTER_KEY
DEVICE_IDENTITY_HMAC_KEY=
PUSH_DISPATCH_ENABLED=false

# 扫链进程（./rn-server indexer）。端点在管理端"扫链管理"里配置，这里只有进程级开关。
INDEXER_ENABLED=false
INDEXER_ALLOW_PLAIN_HTTP=false
# 告警 webhook：POST JSON {text, chain, kind, message, raisedAt, resolved}，text 兼容 Slack / Discord；企业微信需中转
INDEXER_ALERT_WEBHOOK=
# 自动化通道里哪些 actor（ADMIN_API_ACTOR）能进平台级接口，逗号分隔；控制台账号看 tenant_admin_accounts
PLATFORM_ADMIN_USERNAMES=api-key-automation
PUSH_POLL_INTERVAL_SECONDS=10
PUSH_CONCURRENCY=8
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=production
HMS_APP_ID=
HMS_CLIENT_ID=
HMS_CLIENT_SECRET=
ARTIFACT_MAX_SIZE_MB=512
# Use proxy when the OBS bucket cannot allow the RN-Admin browser origin.
ARTIFACT_UPLOAD_MODE=proxy
ARTIFACT_UPLOAD_TTL_SECONDS=900
ARTIFACT_MULTIPART_TTL_SECONDS=7200
ARTIFACT_DOWNLOAD_TTL_SECONDS=300
ARTIFACT_VERIFY_TIMEOUT_SECONDS=300

OTA_CHANNEL=production
ANDROID_STORE_URL=
ANDROID_DIRECT_URL=
IOS_STORE_URL=
IOS_MDM_URL=
