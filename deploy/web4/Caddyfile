{
	servers {
		protocols h1 h2 h3
	}
}

*.{$PUBLIC_BASE_DOMAIN:anyfun.win} {
	encode zstd gzip

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# assetlinks.json 必须挂在域名根下的固定位置，Android 安装时来拉它校验
	# App Link 归属（安全评审 N13）；只放行这一个文件，不放行整个 /.well-known/*，
	# 免得挡到 ACME 挑战之类由 Caddy 自己处理的路径。
	@api path /v1/* /health/* /docs /openapi.json /.well-known/assetlinks.json
	handle @api {
		reverse_proxy server:3000
	}

	@console host {$PUBLIC_CONSOLE_DOMAIN:console.anyfun.win}
	handle @console {
		reverse_proxy admin:80
	}

	respond "Unknown RN Foundation host" 404

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}
}
