# 构建控制进程 build-agent（用户 rn-build-agent）。第三方代码只在它经 sudo 启动的执行进程
# build-runner（用户 builder）里跑；执行进程是这个 unit 的子进程，共用下面的沙箱。
#
# 目录（见 README「目录与权限」）：
#   /opt/rn-build-agent/build-agent、build-runner   root:root 0755
#   /etc/rn-build-agent.env                         root:root 0600（systemd 以 root 读，进程里才有令牌）
#   /var/lib/rn-build-agent/                        rn-build-agent 0700：state/（出处密钥）、repos/、.ssh/
#   /var/lib/rn-build-jobs/                         rn-build-agent:rn-build-jobs 2750：每个任务一个目录
#   /var/cache/rn-build-agent/gradle-ro/            可选的只读 Gradle 依赖缓存
#
# **不能开 NoNewPrivileges**：执行进程靠 sudo（setuid）切到 builder，NoNewPrivileges 会让 sudo
# 失效。同理，systemd 在非 root 服务上遇到下列任何一项都会隐式打开 NoNewPrivileges，所以
# 这里一项都不用：SystemCallFilter、SystemCallArchitectures、RestrictAddressFamilies、
# RestrictNamespaces、PrivateDevices、ProtectKernelTunables、ProtectKernelModules、
# ProtectKernelLogs、ProtectClock、MemoryDenyWriteExecute、RestrictRealtime、RestrictSUIDSGID、
# LockPersonality、DynamicUser。MemoryDenyWriteExecute 还会直接打死 JVM 与 Node 的 JIT。
# 分用户这道边界靠 uid 与文件权限，不靠这些选项。
[Unit]
Description=RN build agent (controller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rn-build-agent
Group=rn-build-agent
# 读执行进程交回的产物（out/ 带 setgid，文件属 rn-build-jobs 组）
SupplementaryGroups=rn-build-jobs
EnvironmentFile=/etc/rn-build-agent.env
# 交给执行进程的 PATH 就是这一个：node、pnpm、java 必须在里面
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/rn-build-agent/build-agent
Restart=always
RestartSec=10
# 机器在控制台被吊销（服务端回 401 MACHINE_REVOKED，或登记成功过之后令牌不再被认）时
# build-agent 以 77 退出：令牌已经没用了，不要每 10 秒重启一次去撞服务端。
# 配置不全是 2，照常重启（改完 env 文件就能起来）。
RestartPreventExitStatus=77
# 停机时先做完手上那一条构建：控制进程收到 SIGTERM 只是不再领新活，手上的构建照常跑完、
# 交付或上报失败，然后退出。
#
# KillMode=mixed：SIGTERM 只发给控制进程。control-group 会把 SIGTERM 发给整个 cgroup，
# sudo 转给执行进程，构建当场被打断——和"先做完"正好相反。
#
# TimeoutStopSec 必须比 BUILD_AGENT_TIMEOUT_MINUTES 长，到期 systemd 对整个 cgroup 补
# SIGKILL。急着换就 `systemctl kill -s SIGKILL rn-build-agent`：任务由服务端回收（或下次
# 启动时以 BUILDER_HAS_ACTIVE_JOB 判失败），残留的任务目录与 builder 进程在下次启动时清掉。
TimeoutStopSec=3600
KillMode=mixed
UMask=0027
LimitCORE=0

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
# 同一个 unit 里的 builder 进程看不见 rn-build-agent 的进程（/proc 按 uid 隐藏）；
# 不用 ProcSubset=pid——JVM 与 Node 要读 /proc/cpuinfo、/proc/meminfo。
ProtectProc=invisible
# 控制进程与执行进程能写的只有这些
ReadWritePaths=/var/lib/rn-build-agent /var/lib/rn-build-jobs
ReadWritePaths=-/run/sudo
# Android SDK、JDK 以只读方式可见（ProtectSystem=strict 已经让它们只读）

# 开发阶段签名闸与构建机同机（deploy/signer/）：签名闸的配置、状态、运行时目录、检查进程
# socket 与程序目录对构建机整个 unit 不可见。真正的边界是这些路径的属主与权限，这里是纵深防御。
InaccessiblePaths=-/etc/rn-signer-a.env -/etc/rn-signer-b.env
InaccessiblePaths=-/var/lib/rn-signer-a -/var/lib/rn-signer-b
InaccessiblePaths=-/run/rn-signer-a -/run/rn-signer-b -/run/rn-signer-a-check.sock -/run/rn-signer-b-check.sock
InaccessiblePaths=-/opt/rn-signer
# 服务端的配置同理
InaccessiblePaths=-/etc/rn-foundation.env

[Install]
WantedBy=multi-user.target
