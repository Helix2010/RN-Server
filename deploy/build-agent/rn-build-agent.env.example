# /etc/rn-build-agent.env —— root:root 0600。systemd 以 root 读它再注入构建控制进程（rn-build-agent）；
# 执行进程（builder）的环境是白名单构造的，这里的值只有 PATH 以外的机器级工具变量会交给它。
#
# 只放启动项与这台机器的拓扑。值里有空格、括号、#、引号就加引号（systemd 会剥掉引号）。

BUILD_AGENT_SERVER=https://api.anyfun.win
# 控制台「平台维护 → 打包机与签名闸」新建这台构建机时显示一次的本机令牌（rnm_…）。
# 由人手输进这个文件，不经过对话、工单、截图。
BUILD_AGENT_MACHINE_TOKEN=

# 仓库镜像（git clone --mirror），属 rn-build-agent，执行进程读不到
BUILD_AGENT_REPO=/var/lib/rn-build-agent/repos/rn-app.git
# 任务根目录：rn-build-agent:rn-build-jobs 2750，每个任务一个 <jobId>/ 目录，用完即删
BUILD_AGENT_WORKSPACE=/var/lib/rn-build-jobs
# 出处签名密钥与上传前的产物副本：rn-build-agent 0700。丢了按新机器处理，不需要备份
BUILD_AGENT_STATE_DIR=/var/lib/rn-build-agent/state

BUILD_AGENT_PLATFORMS=android
BUILD_AGENT_TIMEOUT_MINUTES=45

# 执行进程：经 `sudo -n -u <用户> <程序>` 启动，对应 /etc/sudoers.d/rn-build-agent 里的那条规则。
# BUILD_AGENT_RUNNER_USER=- 表示不经 sudo、与控制进程同一个用户——只许本地测试用，
# 那样第三方构建代码读得到令牌和出处密钥，启动日志会醒目告警。
BUILD_AGENT_RUNNER=/opt/rn-build-agent/build-runner
BUILD_AGENT_RUNNER_USER=builder

# 交给执行进程的机器级工具变量（PATH 在 unit 里设）
LANG=C.UTF-8
ANDROID_HOME=/opt/android-sdk
ANDROID_SDK_ROOT=/opt/android-sdk
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# 只读 Gradle 依赖缓存（可选，见 README「依赖缓存」）。必须属 rn-build-agent、组和其他人不可写；
# 不设就是每个任务从零下载依赖。
#GRADLE_RO_DEP_CACHE=/var/cache/rn-build-agent/gradle-ro
