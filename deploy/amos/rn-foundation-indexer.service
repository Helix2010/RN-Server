# 扫链进程。同一个二进制、不同子命令，配置也是同一份 /etc/rn-foundation.env。
#
# 和 web4 上那个同时开着是安全的：每条链在 chain_scan_state 上有一把租约
# （lease_owner / lease_until），只有抢到的那台真的推进游标，另一台空转等续约。
# 起了这个 unit 就是要扫链，不必再在 env 里写一行开关。显式写 INDEXER_ENABLED=false
# 时进程不退出而是空转——那条是留给容器部署的（防反复重启），裸机上不用。
#
# 它不监听任何端口，所以不需要 nginx，也不该出现在 conf.d 里。
[Unit]
Description=RN Foundation chain indexer
After=network-online.target rn-foundation-platform.service
Wants=network-online.target

[Service]
Type=simple
User=rnfoundation
Group=rnfoundation
EnvironmentFile=/etc/rn-foundation.env
WorkingDirectory=/opt/rn-foundation
ExecStart=/opt/rn-foundation/rn-server indexer
Restart=always
RestartSec=10
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
InaccessiblePaths=/etc/rn-build-agent.env /var/lib/rn-build-agent /opt/rn-build-agent /var/cache/rn-build-agent
# 签名闸（deploy/signer/）的配置、状态、运行时目录、检查进程 socket 与程序对这个进程同样不可见。
# 带 - 的路径不存在时跳过：/run 下的目录与 socket 只有在本服务启动时已经存在才会被遮住，
# 它们自身的属主与 0700/0600 权限仍是主防线，这里是纵深防御
InaccessiblePaths=-/etc/rn-signer-a.env -/etc/rn-signer-b.env -/var/lib/rn-signer-a -/var/lib/rn-signer-b -/run/rn-signer-a -/run/rn-signer-b -/run/rn-signer-a-check.sock -/run/rn-signer-b-check.sock -/opt/rn-signer
ReadWritePaths=/var/lib/rn-foundation

[Install]
WantedBy=multi-user.target
