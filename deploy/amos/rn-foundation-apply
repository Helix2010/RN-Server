#!/usr/bin/env bash
# 装到 /usr/local/sbin/rn-foundation-apply（root:root 0755）。
#
#   sudo rn-foundation-apply server
#   sudo rn-foundation-apply admin <租户 slug>
#   sudo rn-foundation-apply build-agent
#   sudo rn-foundation-apply bundles <提交>
#
# 这是**唯一**一个 CI 能用 sudo 跑的东西。sudoers 里放行的是这个文件、不带参数
# 限制，参数合法性由脚本自己管——理由是：把 install/mv/rm/systemctl 逐条写进
# sudoers，任何一条带通配符的规则写松一点就等于给了 root（`mv * /etc/` 之类）。
# 收口成一个脚本，攻击面就只剩这段代码。
#
# 部署账号除了这个脚本没有任何 sudo 权限；脚本换上去的程序以非 root 身份运行
# （服务端 rnfoundation；构建机控制进程 rn-build-agent），脚本自己也**不以 root 执行**任何
# CI 传来的二进制——构建机的冒烟降到权限更小的执行用户 builder。改脚本或 sudoers 之前先
# 想清楚会不会把这几条破坏掉。
#
# 别把它理解成"拿到 CI 密钥就什么都碰不到"：换得了服务端二进制，就拿得到服务端进程的
# 全部环境（数据库口令、STORAGE_MASTER_KEY）；换得了构建机控制进程，就以 rn-build-agent
# 身份运行，拿得到这台构建机的机器令牌与出处密钥，能以受信构建机的名义交付任意包。
#
# **build-agent 那条因此单独说清楚。** 这台机器开发阶段还和签名闸同机
# （docs/design/android-signing-gate-2026-09-16.md「开发阶段的部署」），同机期间工作流里的
# AMOS_DEPLOY_BUILD_AGENT 必须关着，打包机手工部署（见 deploy/amos/README.md）。
set -euo pipefail

STAGE_ROOT=/var/lib/rn-foundation-deploy/incoming
ADMIN_ROOT=/opt/rn-foundation/admin
BINARY=/opt/rn-foundation/rn-server
PREVIOUS=/opt/rn-foundation/rn-server.prev
BUNDLE_ROOT=/opt/rn-foundation/machine-bundles
# 保留几份不是 current 的旧安装包（回滚服务端时，旧服务端的 describe 读到的还是 current）
BUNDLE_KEEP_PREVIOUS=2
AGENT_BINARY=/opt/rn-build-agent/build-agent
AGENT_PREVIOUS=/opt/rn-build-agent/build-agent.prev
# 构建机冒烟用的身份：执行用户 builder，比正式运行控制进程的 rn-build-agent 权限更小
# （读不到令牌与出处密钥），也不是 root。冒烟只验"跑得起来"，不需要控制进程的任何东西
AGENT_USER=builder
# 打包机冒烟用的临时目录；非空时退出前删掉
SMOKE_DIR=""
trap '[ -z "$SMOKE_DIR" ] || rm -rf "$SMOKE_DIR"' EXIT

log() { printf '   %s\n' "$*"; }
die() { printf '%s\n' "$*" >&2; exit 1; }

# 两个仓库的 CI 各有各的 concurrency group，管不到对方，服务端和控制台的部署可能
# 同时落到这台机器上。串行化的代价只是多等几十秒
exec 9>/var/lib/rn-foundation-deploy/.apply.lock
flock -w 300 9 || die "另一个部署正在进行，等了 5 分钟还没轮到"

# API 按角色拆成三个进程（设计 docs/design/service-and-console-split-2026-09-27.md），同一个二进制。
# 平台端排第一：打包任务回收与推送派发两个后台任务在它里面
API_UNITS=(rn-foundation-platform rn-foundation-tenant rn-foundation-app)

# 端口从 unit 的 ExecStart（`rn-server <角色> --port N`）里读，别在两个地方各写一遍。
# awk 读完整份输出再在 END 里打印，不会让 systemctl 吃 SIGPIPE（`… | head -1` 在 pipefail 下
# 会让整个命令替换返回非零，配上 set -e 就是脚本从中间无声地断掉——这个坑踩过一次了）
unit_port() { # $1 = unit
  systemctl cat "$1" 2>/dev/null |
    awk '/^ExecStart=/{for (i = 1; i < NF; i++) if ($i == "--port") p = $(i + 1)} END{print p}' || true
}

wait_ready() { # $1 = 最多等几秒；三个进程都就绪才算
  local deadline unit port
  deadline=$(( $(date +%s) + $1 ))
  for unit in "${API_UNITS[@]}"; do
    port="$(unit_port "$unit")"
    if ! [[ "$port" =~ ^[0-9]+$ ]]; then
      log "$unit 的 ExecStart 里读不到 --port"
      return 1
    fi
    until curl -fsS --max-time 3 "http://127.0.0.1:$port/health/ready" >/dev/null 2>&1; do
      if [ "$(date +%s)" -ge "$deadline" ]; then
        log "$unit（端口 $port）没有就绪"
        return 1
      fi
      sleep 2
    done
  done
}

api_journal() {
  local unit
  for unit in "${API_UNITS[@]}"; do
    journalctl -u "$unit" -n 20 --no-pager -o cat >&2 || true
  done
}

apply_server() {
  local src="$STAGE_ROOT/rn-server"
  [ -s "$src" ] || die "暂存目录里没有 rn-server：$src"
  # 只认 ELF：上传环节出问题时（截断、传成了 tar）早点炸，别等到 systemd 起不来
  [ "$(head -c 4 "$src" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ] \
    || die "$src 不是 ELF 可执行文件"

  log "停服务"
  # 先停扫链再停 API：扫链依赖 API 先就绪，反过来停会多打一轮连接失败的日志
  systemctl stop rn-foundation-indexer "${API_UNITS[@]}" || true

  if [ -f "$BINARY" ]; then
    cp -a "$BINARY" "$PREVIOUS"
  else
    rm -f "$PREVIOUS"
  fi
  install -m 0755 -o root -g root "$src" "$BINARY"
  rm -f "$src"

  log "执行数据库迁移"
  # 迁移在新二进制就位之后、服务启动之前跑：新代码要的列必须先存在。迁移只进不退，
  # 反复执行是幂等的
  if ! systemctl start rn-foundation-migrate; then
    journalctl -u rn-foundation-migrate -n 30 --no-pager -o cat >&2
    rollback_server "迁移失败"
    die "迁移失败，已回滚二进制"
  fi

  log "启动"
  systemctl start "${API_UNITS[@]}" || true
  if ! wait_ready 90; then
    api_journal
    rollback_server "健康检查没通过"
    die "新版本起不来，已回滚二进制"
  fi
  systemctl start rn-foundation-indexer \
    || log "警告：扫链没起来，API 不受影响，去看 journalctl -u rn-foundation-indexer"

  rm -f "$PREVIOUS"
  log "服务端已更新"
}

rollback_server() {
  # 注意：迁移已经跑过的不会退回去。迁移只加不减，旧代码能在新表结构上跑，这是
  # 回滚成立的前提——哪天写了一条破坏性迁移，这里就不再安全了
  log "回滚（$1）"
  if [ -f "$PREVIOUS" ]; then
    install -m 0755 -o root -g root "$PREVIOUS" "$BINARY"
    rm -f "$PREVIOUS"
    systemctl restart "${API_UNITS[@]}" || true
    systemctl start rn-foundation-indexer || true
    if wait_ready 60; then
      log "已回到上一版"
    else
      log "上一版也没起来，需要人工介入"
    fi
  else
    log "没有上一版可回滚（首次部署）"
  fi
}

apply_admin() {
  local slug="${1:-}"
  # slug 会拼进路径。限死字符集并挡住 ..，别让部署账号能写到 admin 目录之外
  case "$slug" in
    ""|*/*|*..*) die "非法的租户 slug: ${slug:-（空）}" ;;
  esac
  [[ "$slug" =~ ^[a-z0-9][a-z0-9._-]{0,30}$ ]] || die "非法的租户 slug: $slug"

  local src="$STAGE_ROOT/admin/$slug"
  [ -d "$src" ] || die "暂存目录里没有 $slug：$src"
  # 没有 index.html 的目录换上去等于把控制台换成 404
  [ -s "$src/index.html" ] || die "$src 里没有 index.html，不换"

  local dest="$ADMIN_ROOT/$slug" old="$ADMIN_ROOT/.$slug.old"
  mkdir -p "$ADMIN_ROOT"
  rm -rf "$old"
  # 不写成 `[ -d ] && mv || true`：mv 真失败时会被 || true 吞掉，接着那句
  # `mv "$src" "$dest"` 就变成把新产物塞进旧目录里面，而不是替换它
  if [ -d "$dest" ]; then
    mv "$dest" "$old"
  fi
  mv "$src" "$dest"
  chown -R root:root "$dest"
  # 显式定死权限而不是 a+rX：tar 解出来的目录带着上传账号 umask 留下的组写位，
  # 这些文件是 nginx 直接对外发的，不该保留任何多余的可写位
  chmod -R u=rwX,go=rX "$dest"
  rm -rf "$old"
  # 整目录换掉而不是覆盖：上一版留下的旧 chunk 必须消失，否则目录只会越长越大。
  # 不 reload nginx——静态文件不经过它的缓存（open_file_cache 默认关），换完即生效
  log "$slug 控制台已更新"
}

# 打包机。和服务端不同的两件事：
#
#  1. **不阻塞等它停。** 代理收到 SIGTERM 会先把手上那条构建做完（最长
#     BUILD_AGENT_TIMEOUT_MINUTES，默认 45 分钟，unit 里 TimeoutStopSec=3600）。
#     阻塞式 restart 会把 CI 挂在那里直到超时被杀，而被杀掉的那条构建要人重新排。
#     所以 --no-block 发出去，然后看一眼结果，排空中就如实说"排空中"。
#  2. **没有健康检查可等。** 它不监听任何端口（只出不进），活着的判据只有
#     systemd 的 ActiveState 和 MainPID 变没变。
apply_build_agent() {
  local src="$STAGE_ROOT/build-agent"
  [ -s "$src" ] || die "暂存目录里没有 build-agent：$src"
  [ "$(head -c 4 "$src" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ] \
    || die "$src 不是 ELF 可执行文件"
  # 取数字 uid/gid：--regid 要的是组，账号的主组不一定和账号同名
  local agent_uid agent_gid
  agent_uid="$(id -u "$AGENT_USER" 2>/dev/null)" || die "没有 $AGENT_USER 账号，冒烟不能改用 root 跑"
  agent_gid="$(id -g "$AGENT_USER")"

  # 冒烟：不带任何配置跑一下，它必须以 2 退出并抱怨配置不全。这不验业务，
  # 它验的是"这个二进制在这台机器上跑得起来"——架构不对、动态链接缺库都在这里露馅，
  # 而不是换上去之后由 systemd 反复重启。
  #
  # **不以 root 跑。** 这是 CI 传来的、还没审过的二进制，root 执行它等于能推 main 或
  # 拿到 AMOS_SSH_KEY 的人拿到这台机器的 root。以执行用户 builder 跑（比控制进程的
  # rn-build-agent 权限更小），不继承附加组、不许再提权。先拷进 root 的目录再跑：暂存目录
  # 属 rndeploy，builder 未必进得去；换上去的也就是跑过冒烟的这一份
  SMOKE_DIR="$(mktemp -d "$(dirname "$AGENT_BINARY")/.build-agent-smoke.XXXXXX")" \
    || die "建不了冒烟用的临时目录"
  chmod 0711 "$SMOKE_DIR"
  install -m 0755 -o root -g root "$src" "$SMOKE_DIR/build-agent"
  local code=0
  setpriv --reuid="$agent_uid" --regid="$agent_gid" --clear-groups --no-new-privs \
    env -i "$SMOKE_DIR/build-agent" >/dev/null 2>&1 || code=$?
  [ "$code" = "2" ] || die "新的 build-agent 跑不起来（以 $AGENT_USER 身份，退出码 $code），不换"

  local before_pid
  before_pid="$(systemctl show -p MainPID --value rn-build-agent 2>/dev/null || echo 0)"

  if [ -f "$AGENT_BINARY" ]; then
    cp -a "$AGENT_BINARY" "$AGENT_PREVIOUS"
  else
    rm -f "$AGENT_PREVIOUS"
  fi
  # 正在跑的进程握着旧 inode，install 不会打断它
  install -m 0755 -o root -g root "$SMOKE_DIR/build-agent" "$AGENT_BINARY"
  rm -f "$src"

  log "请求重启（手上有构建的话会先把它做完）"
  systemctl --no-block restart rn-build-agent

  local deadline=$(( $(date +%s) + 90 )) state pid
  while [ "$(date +%s)" -lt "$deadline" ]; do
    state="$(systemctl show -p ActiveState --value rn-build-agent 2>/dev/null || true)"
    pid="$(systemctl show -p MainPID --value rn-build-agent 2>/dev/null || echo 0)"
    if [ "$state" = "active" ] && [ "$pid" != "$before_pid" ] && [ "$pid" != "0" ]; then
      rm -f "$AGENT_PREVIOUS"
      log "打包机已更新并起来了（pid $pid）"
      return 0
    fi
    if [ "$state" = "failed" ]; then
      log "回滚（新二进制起不来）"
      if [ -f "$AGENT_PREVIOUS" ]; then
        install -m 0755 -o root -g root "$AGENT_PREVIOUS" "$AGENT_BINARY"
        rm -f "$AGENT_PREVIOUS"
        systemctl --no-block restart rn-build-agent
      fi
      journalctl -u rn-build-agent -n 30 --no-pager -o cat >&2
      die "新的 build-agent 起不来，已回滚二进制"
    fi
    sleep 3
  done

  # 90 秒还没换 pid：多半是在排空一条构建。这不是失败，但也不能说"已更新"——
  # 新二进制在磁盘上，生效时机是那条构建做完
  rm -f "$AGENT_PREVIOUS"
  log "新二进制已就位；代理正在把手上那条构建做完，做完自动起新版（systemctl status rn-build-agent 看进度）"
}

# 新机器的安装包（deploy/setup/build-bundles.sh 的产物）。服务端 GET /v1/machine-setup/bundle/<角色>.tar.gz
# 从 $BUNDLE_ROOT/current/ 读，describe 的清单来自同目录的 manifest.json。
#
# 这一步不执行任何 CI 传来的东西，只是把三个文件以 root 拷进新目录、原子切换 current 软链。
# 安装包里有签名闸程序：换得了它就能给**之后新装**的机器下发篡改过的程序（设计「5. 安装包的来源」的
# 残余风险）；已经在跑的签名闸不从这里升级。生产上签名闸安装时要用 CI 日志里的 sha256 核对（--expect-sha256）。
apply_bundles() {
  local commit="${1:-}"
  # 提交会拼进路径与 grep 的模式：只认 40 位小写十六进制
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "非法的提交: ${commit:-（空）}"
  local src="$STAGE_ROOT/machine-bundles" f
  if [ -L "$src" ] || [ ! -d "$src" ]; then
    die "暂存目录里没有安装包：$src"
  fi
  # 五个：清单、三组归档，以及发布公钥。**release-key.pub 不是可选的**——Mac 装机要在下载
  # 归档之前就拿到它来验清单的离线签名，而归档里那一份得先解包才看得见，那时清单还没验过。
  # 它缺了的症状是 describe 回 503，而控制台上那组安装包看着一切正常（卡片只校验清单里的
  # 条目，不看文件在不在）。
  [ "$(find "$src" -mindepth 1 -maxdepth 1 | wc -l)" = 5 ] || die "暂存的安装包目录里应该正好是五个文件，不换"

  # 暂存目录属于部署账号，它随时能换掉里面的东西：先把三个文件拷成 root 自己的副本
  # （cp -P 不跟随符号链接，指向别处的链接拷过来还是链接，下面拒绝），之后只核对、只用副本
  install -d -o root -g root -m 0755 "$BUNDLE_ROOT"
  # 上一次中途失败留下的副本（部署有 flock 串行，这里不会碰到正在进行的另一次）
  rm -rf "$BUNDLE_ROOT"/.incoming-*
  local tmp="$BUNDLE_ROOT/.incoming-$$"
  install -d -o root -g root -m 0700 "$tmp"
  for f in manifest.json signer.tar.gz builder.tar.gz builder-darwin-arm64.tar.gz release-key.pub; do
    if [ -L "$src/$f" ] || [ ! -f "$src/$f" ]; then
      rm -rf "$tmp"
      die "暂存的安装包缺 $f，或者它不是普通文件"
    fi
    cp -P "$src/$f" "$tmp/$f"
    if [ -L "$tmp/$f" ] || [ ! -f "$tmp/$f" ] || [ ! -s "$tmp/$f" ]; then
      rm -rf "$tmp"
      die "暂存的安装包里 $f 不是非空的普通文件，不换"
    fi
    chown root:root "$tmp/$f"
    chmod 0644 "$tmp/$f"
  done

  # 上传不完整时早点炸：清单是这个提交的，两个归档的 sha256 都在清单里
  local sum problem=""
  grep -q '"format": *"rn-machine-bundles/v1"' "$tmp/manifest.json" || problem="manifest.json 的 format 不是 rn-machine-bundles/v1"
  grep -Eq "\"commit\": *\"$commit\"" "$tmp/manifest.json" || problem="manifest.json 不是提交 $commit 的"
  for f in signer.tar.gz builder.tar.gz builder-darwin-arm64.tar.gz; do
    sum="$(sha256sum "$tmp/$f")"
    grep -Eq "\"archiveSha256\": *\"${sum%% *}\"" "$tmp/manifest.json" || problem="$f 的 sha256 不在 manifest.json 里（上传不完整？）"
  done
  # 发布公钥是 Mac 那条链子的信任根。它不在清单里（清单正是靠它验的），所以这里只查形状：
  # 一行 OpenSSH 公钥。真正的核对在 Mac 上，按运维从密码管理器带来的指纹做
  grep -Eq '^ssh-ed25519 [A-Za-z0-9+/]+=* ' "$tmp/release-key.pub" ||
    problem="release-key.pub 不是一行 ssh-ed25519 公钥"
  if [ -n "$problem" ]; then
    rm -rf "$tmp"
    die "$problem，不换"
  fi

  local name="$commit" dest same=yes
  dest="$BUNDLE_ROOT/$name"
  if [ -d "$dest" ]; then
    for f in manifest.json signer.tar.gz builder.tar.gz builder-darwin-arm64.tar.gz release-key.pub; do
      cmp -s "$tmp/$f" "$dest/$f" || same=no
    done
    if [ "$same" = no ]; then
      # 同一提交重跑、但工具链变了编出不同的字节：另起一个目录，不动正在用的那份
      name="$commit-$(date -u +%Y%m%dT%H%M%SZ)"
      dest="$BUNDLE_ROOT/$name"
    fi
  fi
  if [ -d "$dest" ]; then
    rm -rf "$tmp"
  else
    chmod 0755 "$tmp"
    mv -T "$tmp" "$dest"
  fi

  # 原子切换：新软链先建在旁边，再 rename 覆盖 current
  ln -sfn "$name" "$BUNDLE_ROOT/.current.new"
  mv -T "$BUNDLE_ROOT/.current.new" "$BUNDLE_ROOT/current"
  rm -rf "$src"
  log "安装包已切换到 $name"
  local line
  while read -r line; do
    log "$line"
  done < <(cd "$dest" && sha256sum signer.tar.gz builder.tar.gz builder-darwin-arm64.tar.gz)

  # 只留 current 与最近几份
  local kept=0 dir
  while IFS= read -r dir; do
    [ "$dir" = "$name" ] && continue
    kept=$((kept + 1))
    if [ "$kept" -gt "$BUNDLE_KEEP_PREVIOUS" ]; then
      rm -rf "${BUNDLE_ROOT:?}/$dir"
    fi
  done < <(find "$BUNDLE_ROOT" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%T@ %f\n' | sort -rn | cut -d' ' -f2)
}

case "${1:-}" in
server)      apply_server ;;
admin)       apply_admin "${2:-}" ;;
build-agent) apply_build_agent ;;
bundles)     apply_bundles "${2:-}" ;;
*) die "用法: $0 server | $0 admin <租户 slug> | $0 build-agent | $0 bundles <提交>" ;;
esac
