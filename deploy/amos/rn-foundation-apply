#!/usr/bin/env bash
# 装到 /usr/local/sbin/rn-foundation-apply（root:root 0755）。
#
#   sudo rn-foundation-apply server
#   sudo rn-foundation-apply admin <租户 slug>
#   sudo rn-foundation-apply build-agent
#
# 这是**唯一**一个 CI 能用 sudo 跑的东西。sudoers 里放行的是这个文件、不带参数
# 限制，参数合法性由脚本自己管——理由是：把 install/mv/rm/systemctl 逐条写进
# sudoers，任何一条带通配符的规则写松一点就等于给了 root（`mv * /etc/` 之类）。
# 收口成一个脚本，攻击面就只剩这段代码。
#
# 部署账号除了这个脚本没有任何 sudo 权限；脚本换上去的程序以非 root 身份运行
# （服务端 rnfoundation、打包机 builder），脚本自己也**不以 root 执行**任何 CI 传来的
# 二进制——打包机的冒烟同样降到 builder。改脚本或 sudoers 之前先想清楚会不会把这几条
# 破坏掉。
#
# 别把它理解成"拿到 CI 密钥就什么都碰不到"：换得了服务端二进制，就拿得到服务端进程的
# 全部环境（数据库口令、STORAGE_MASTER_KEY）；换得了打包机二进制，就能以 builder 身份
# 在这台机器上执行任意代码。
#
# **build-agent 那条因此单独说清楚。** 这台机器开发阶段还和签名闸同机
# （docs/design/android-signing-gate-2026-09-16.md「开发阶段的部署」），同机期间工作流里的
# AMOS_DEPLOY_BUILD_AGENT 必须关着，打包机手工部署（见 deploy/amos/README.md）。
set -euo pipefail

STAGE_ROOT=/var/lib/rn-foundation-deploy/incoming
ADMIN_ROOT=/opt/rn-foundation/admin
BINARY=/opt/rn-foundation/rn-server
PREVIOUS=/opt/rn-foundation/rn-server.prev
AGENT_BINARY=/opt/rn-build-agent/build-agent
AGENT_PREVIOUS=/opt/rn-build-agent/build-agent.prev
# 打包机正式运行时的身份，冒烟也用它，不用 root
AGENT_USER=builder
ENV_FILE=/etc/rn-foundation.env
# 打包机冒烟用的临时目录；非空时退出前删掉
SMOKE_DIR=""
trap '[ -z "$SMOKE_DIR" ] || rm -rf "$SMOKE_DIR"' EXIT

log() { printf '   %s\n' "$*"; }
die() { printf '%s\n' "$*" >&2; exit 1; }

# 两个仓库的 CI 各有各的 concurrency group，管不到对方，服务端和控制台的部署可能
# 同时落到这台机器上。串行化的代价只是多等几十秒
exec 9>/var/lib/rn-foundation-deploy/.apply.lock
flock -w 300 9 || die "另一个部署正在进行，等了 5 分钟还没轮到"

# 端口从配置里读，别在两个地方各写一遍一个会变的数字
# 一条 awk 搞定，不接管道：`… | head -1` 在 pipefail 下会因为 SIGPIPE 让整个
# 命令替换返回非零，配上 set -e 就是脚本从中间无声地断掉——这个坑踩过一次了
app_port() {
  local port
  port="$(awk -F= '/^PORT=/{gsub(/[^0-9]/, "", $2); print $2; exit}' "$ENV_FILE" 2>/dev/null || true)"
  printf '%s' "${port:-13080}"
}

wait_ready() { # $1 = 最多等几秒
  local port deadline
  port="$(app_port)"
  deadline=$(( $(date +%s) + $1 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if curl -fsS --max-time 3 "http://127.0.0.1:$port/health/ready" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

apply_server() {
  local src="$STAGE_ROOT/rn-server"
  [ -s "$src" ] || die "暂存目录里没有 rn-server：$src"
  # 只认 ELF：上传环节出问题时（截断、传成了 tar）早点炸，别等到 systemd 起不来
  [ "$(head -c 4 "$src" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ] \
    || die "$src 不是 ELF 可执行文件"

  log "停服务"
  # 先停扫链再停 API：扫链依赖 API 先就绪，反过来停会多打一轮连接失败的日志
  systemctl stop rn-foundation-indexer rn-foundation-server || true

  if [ -f "$BINARY" ]; then
    cp -a "$BINARY" "$PREVIOUS"
  else
    rm -f "$PREVIOUS"
  fi
  install -m 0755 -o root -g root "$src" "$BINARY"
  rm -f "$src"

  log "执行数据库迁移"
  # 迁移在新二进制就位之后、服务启动之前跑：新代码要的列必须先存在。迁移只进不退，
  # 反复执行是幂等的
  if ! systemctl start rn-foundation-migrate; then
    journalctl -u rn-foundation-migrate -n 30 --no-pager -o cat >&2
    rollback_server "迁移失败"
    die "迁移失败，已回滚二进制"
  fi

  log "启动"
  systemctl start rn-foundation-server
  if ! wait_ready 90; then
    journalctl -u rn-foundation-server -n 40 --no-pager -o cat >&2
    rollback_server "健康检查没通过"
    die "新版本起不来，已回滚二进制"
  fi
  systemctl start rn-foundation-indexer \
    || log "警告：扫链没起来，API 不受影响，去看 journalctl -u rn-foundation-indexer"

  rm -f "$PREVIOUS"
  log "服务端已更新"
}

rollback_server() {
  # 注意：迁移已经跑过的不会退回去。迁移只加不减，旧代码能在新表结构上跑，这是
  # 回滚成立的前提——哪天写了一条破坏性迁移，这里就不再安全了
  log "回滚（$1）"
  if [ -f "$PREVIOUS" ]; then
    install -m 0755 -o root -g root "$PREVIOUS" "$BINARY"
    rm -f "$PREVIOUS"
    systemctl start rn-foundation-server || true
    systemctl start rn-foundation-indexer || true
    if wait_ready 60; then
      log "已回到上一版"
    else
      log "上一版也没起来，需要人工介入"
    fi
  else
    log "没有上一版可回滚（首次部署）"
  fi
}

apply_admin() {
  local slug="${1:-}"
  # slug 会拼进路径。限死字符集并挡住 ..，别让部署账号能写到 admin 目录之外
  case "$slug" in
    ""|*/*|*..*) die "非法的租户 slug: ${slug:-（空）}" ;;
  esac
  [[ "$slug" =~ ^[a-z0-9][a-z0-9._-]{0,30}$ ]] || die "非法的租户 slug: $slug"

  local src="$STAGE_ROOT/admin/$slug"
  [ -d "$src" ] || die "暂存目录里没有 $slug：$src"
  # 没有 index.html 的目录换上去等于把控制台换成 404
  [ -s "$src/index.html" ] || die "$src 里没有 index.html，不换"

  local dest="$ADMIN_ROOT/$slug" old="$ADMIN_ROOT/.$slug.old"
  mkdir -p "$ADMIN_ROOT"
  rm -rf "$old"
  # 不写成 `[ -d ] && mv || true`：mv 真失败时会被 || true 吞掉，接着那句
  # `mv "$src" "$dest"` 就变成把新产物塞进旧目录里面，而不是替换它
  if [ -d "$dest" ]; then
    mv "$dest" "$old"
  fi
  mv "$src" "$dest"
  chown -R root:root "$dest"
  # 显式定死权限而不是 a+rX：tar 解出来的目录带着上传账号 umask 留下的组写位，
  # 这些文件是 nginx 直接对外发的，不该保留任何多余的可写位
  chmod -R u=rwX,go=rX "$dest"
  rm -rf "$old"
  # 整目录换掉而不是覆盖：上一版留下的旧 chunk 必须消失，否则目录只会越长越大。
  # 不 reload nginx——静态文件不经过它的缓存（open_file_cache 默认关），换完即生效
  log "$slug 控制台已更新"
}

# 打包机。和服务端不同的两件事：
#
#  1. **不阻塞等它停。** 代理收到 SIGTERM 会先把手上那条构建做完（最长
#     BUILD_AGENT_TIMEOUT_MINUTES，默认 45 分钟，unit 里 TimeoutStopSec=3600）。
#     阻塞式 restart 会把 CI 挂在那里直到超时被杀，而被杀掉的那条构建要人重新排。
#     所以 --no-block 发出去，然后看一眼结果，排空中就如实说"排空中"。
#  2. **没有健康检查可等。** 它不监听任何端口（只出不进），活着的判据只有
#     systemd 的 ActiveState 和 MainPID 变没变。
apply_build_agent() {
  local src="$STAGE_ROOT/build-agent"
  [ -s "$src" ] || die "暂存目录里没有 build-agent：$src"
  [ "$(head -c 4 "$src" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ] \
    || die "$src 不是 ELF 可执行文件"
  # 取数字 uid/gid：--regid 要的是组，账号的主组不一定和账号同名
  local agent_uid agent_gid
  agent_uid="$(id -u "$AGENT_USER" 2>/dev/null)" || die "没有 $AGENT_USER 账号，冒烟不能改用 root 跑"
  agent_gid="$(id -g "$AGENT_USER")"

  # 冒烟：不带任何配置跑一下，它必须以 2 退出并抱怨配置不全。这不验业务，
  # 它验的是"这个二进制在这台机器上跑得起来"——架构不对、动态链接缺库都在这里露馅，
  # 而不是换上去之后由 systemd 反复重启。
  #
  # **不以 root 跑。** 这是 CI 传来的、还没审过的二进制，root 执行它等于能推 main 或
  # 拿到 AMOS_SSH_KEY 的人拿到这台机器的 root。以它正式运行时的 builder 身份跑，
  # 不继承附加组、不许再提权。先拷进 root 的目录再跑：暂存目录属 rndeploy，builder
  # 未必进得去；换上去的也就是跑过冒烟的这一份
  SMOKE_DIR="$(mktemp -d "$(dirname "$AGENT_BINARY")/.build-agent-smoke.XXXXXX")" \
    || die "建不了冒烟用的临时目录"
  chmod 0711 "$SMOKE_DIR"
  install -m 0755 -o root -g root "$src" "$SMOKE_DIR/build-agent"
  local code=0
  setpriv --reuid="$agent_uid" --regid="$agent_gid" --clear-groups --no-new-privs \
    env -i "$SMOKE_DIR/build-agent" >/dev/null 2>&1 || code=$?
  [ "$code" = "2" ] || die "新的 build-agent 跑不起来（以 $AGENT_USER 身份，退出码 $code），不换"

  local before_pid
  before_pid="$(systemctl show -p MainPID --value rn-build-agent 2>/dev/null || echo 0)"

  if [ -f "$AGENT_BINARY" ]; then
    cp -a "$AGENT_BINARY" "$AGENT_PREVIOUS"
  else
    rm -f "$AGENT_PREVIOUS"
  fi
  # 正在跑的进程握着旧 inode，install 不会打断它
  install -m 0755 -o root -g root "$SMOKE_DIR/build-agent" "$AGENT_BINARY"
  rm -f "$src"

  log "请求重启（手上有构建的话会先把它做完）"
  systemctl --no-block restart rn-build-agent

  local deadline=$(( $(date +%s) + 90 )) state pid
  while [ "$(date +%s)" -lt "$deadline" ]; do
    state="$(systemctl show -p ActiveState --value rn-build-agent 2>/dev/null || true)"
    pid="$(systemctl show -p MainPID --value rn-build-agent 2>/dev/null || echo 0)"
    if [ "$state" = "active" ] && [ "$pid" != "$before_pid" ] && [ "$pid" != "0" ]; then
      rm -f "$AGENT_PREVIOUS"
      log "打包机已更新并起来了（pid $pid）"
      return 0
    fi
    if [ "$state" = "failed" ]; then
      log "回滚（新二进制起不来）"
      if [ -f "$AGENT_PREVIOUS" ]; then
        install -m 0755 -o root -g root "$AGENT_PREVIOUS" "$AGENT_BINARY"
        rm -f "$AGENT_PREVIOUS"
        systemctl --no-block restart rn-build-agent
      fi
      journalctl -u rn-build-agent -n 30 --no-pager -o cat >&2
      die "新的 build-agent 起不来，已回滚二进制"
    fi
    sleep 3
  done

  # 90 秒还没换 pid：多半是在排空一条构建。这不是失败，但也不能说"已更新"——
  # 新二进制在磁盘上，生效时机是那条构建做完
  rm -f "$AGENT_PREVIOUS"
  log "新二进制已就位；代理正在把手上那条构建做完，做完自动起新版（systemctl status rn-build-agent 看进度）"
}

case "${1:-}" in
server)      apply_server ;;
admin)       apply_admin "${2:-}" ;;
build-agent) apply_build_agent ;;
*) die "用法: $0 server | $0 admin <租户 slug> | $0 build-agent" ;;
esac
