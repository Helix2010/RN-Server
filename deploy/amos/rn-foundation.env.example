# amos 上 RN-Foundation 的配置。安装到 /etc/rn-foundation.env，0600 root。
#
# 这份配置同时被 rn-foundation-server 与 rn-foundation-indexer 两个 unit 读取。
# **不要放 BUILD_AGENT_TOKEN**：打包机代理连的是 web4，amos 这台不需要开
# /v1/build-agent 这条通道，留空即整条关闭。

APP_ENV=production
# 只监听回环，公网流量一律经 nginx 的 443 进来。裸机部署没有 Docker 的端口映射
# 兜底，不写 BIND_ADDRESS 的话 13080 会绕过 nginx 直接对外，TLS 就白设了
BIND_ADDRESS=127.0.0.1
PORT=13080
HTTP_READ_TIMEOUT_SECONDS=3600
HTTP_WRITE_TIMEOUT_SECONDS=3600

# 两个租户的控制台源，缺一个那个控制台的 XHR 就会被浏览器拦掉
CORS_ORIGINS=https://console.any123.top,https://console.predict.kim

# 会话 Cookie 只在 HTTPS 下下发；证书没配好之前不要改成 false
ADMIN_COOKIE_SECURE=true
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD_HASH=CHANGE_ME_ADMIN_PASSWORD_HASH
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

# **与 web4 那把不同**。同一把密钥放两台机器，任何一台泄漏就等于两台都失守
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY
ADMIN_API_ACTOR=api-key-automation
PLATFORM_ADMIN_USERNAMES=

# x-admin-key 的来源绑定（安全评审 N17）。nginx 在本机，所以可信代理就是回环；
# 不写 TRUSTED_PROXIES 时 gin 信任所有上游，ClientIP 可被 X-Forwarded-For 伪造，
# 那时候 ADMIN_API_ALLOWED_IPS 只是摆设——服务端会拒绝启动
TRUSTED_PROXIES=127.0.0.1
ADMIN_API_ALLOWED_IPS=

# 数据库与 web4 同一套。**照抄 web4 的 .env，不要另填**：两边连的必须是同一个库，
# 否则租户、发布记录、扫链游标全都对不上
MYSQL_HOST=CHANGE_ME_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME_MYSQL_USER
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=CHANGE_ME_MYSQL_DATABASE
MYSQL_CONNECTION_LIMIT=3
MYSQL_MAX_IDLE_CONNECTIONS=1
MYSQL_CONNECTION_MAX_LIFETIME_SECONDS=600
MYSQL_CONNECTION_MAX_IDLE_TIME_SECONDS=60
MYSQL_QUERY_TIMEOUT_SECONDS=10
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=Z
MYSQL_PARSE_TIME=true
MYSQL_CONNECT_TIMEOUT_SECONDS=15
MYSQL_READ_TIMEOUT_SECONDS=15
MYSQL_WRITE_TIMEOUT_SECONDS=15
MYSQL_INIT_TIMEOUT_SECONDS=30
MYSQL_INIT_MAX_ATTEMPTS=3
MYSQL_INIT_RETRY_DELAY_SECONDS=5
# 表结构只由 web4 推进。两台都开 migrate 等于两个写入方抢同一张 schema_migrations
MYSQL_AUTO_MIGRATE=false

# 与 web4 **必须一致**：它解密库里的租户对象存储凭据，换一把就全读不出来
STORAGE_MASTER_KEY=CHANGE_ME_STORAGE_MASTER_KEY

ARTIFACT_MAX_SIZE_MB=512
ARTIFACT_UPLOAD_MODE=direct
ARTIFACT_UPLOAD_TTL_SECONDS=900
ARTIFACT_MULTIPART_TTL_SECONDS=7200
ARTIFACT_DOWNLOAD_TTL_SECONDS=300
ARTIFACT_VERIFY_TIMEOUT_SECONDS=300
OTA_CHANNEL=production
ANDROID_STORE_URL=
ANDROID_DIRECT_URL=
IOS_STORE_URL=
IOS_MDM_URL=

# 与 web4 一致，否则同一台设备在两边算出不同的 installation 指纹
DEVICE_IDENTITY_HMAC_KEY=

# 推送派发：出站队列的认领是 CAS（status='pending' 时才抢到），多实例安全。
# 但两台一起派发只会让同一批消息分摊，收益为零——默认关掉，留给 web4
PUSH_DISPATCH_ENABLED=false
PUSH_POLL_INTERVAL_SECONDS=10
PUSH_CONCURRENCY=8
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# 扫链。每条链一把租约（chain_scan_state.lease_owner），同一时刻只有一个实例在扫，
# 所以和 web4 同时开着是安全的：抢到租约的那台干活，另一台空转等续约
INDEXER_ENABLED=true
INDEXER_ALLOW_PLAIN_HTTP=false
INDEXER_ALERT_WEBHOOK=
INDEXER_MYSQL_CONNECTION_LIMIT=4
