# amos 上 RN-Foundation 的配置。安装到 /etc/rn-foundation.env，0600 root。
#
# 这份配置同时被 rn-foundation-server、rn-foundation-indexer 和 rn-foundation-migrate
# 三个 unit 读取。
#
# **原则：只放"别处不可能知道"的东西**——机密与这台机器的拓扑。有默认值的不写，
# 能从库里推导的不填，按租户变化的进租户配置。这份文件曾经有 61 行，其中 24 行写的
# 就是代码里的默认值——那 24 行的代价不是磁盘，是以后没人能一眼看出哪些是特意设成
# 这样的。
#
# 要知道全部可用的键和它们的默认值，看 ../../docs/CONFIGURATION.md；要知道这台机器上
# **实际生效**的是什么，跑 `rn-server config`（机密只显示长度，可以直接贴进工单）。

APP_ENV=production
# 只监听回环，公网流量一律经 nginx 的 443 进来。裸机部署没有 Docker 的端口映射
# 兜底，不写 BIND_ADDRESS 的话 13080 会绕过 nginx 直接对外，TLS 就白设了
BIND_ADDRESS=127.0.0.1
PORT=13080

# x-admin-key 的来源绑定（安全评审 N17）。nginx 在本机，所以可信代理就是回环；
# 不写 TRUSTED_PROXIES 时 gin 信任所有上游，ClientIP 可被 X-Forwarded-For 伪造，
# 那时候 ADMIN_API_ALLOWED_IPS 只是摆设
TRUSTED_PROXIES=127.0.0.1

# 能进平台级页面（扫链管理、打包机公钥、平台推送默认）的管理员
PLATFORM_ADMIN_USERNAMES=CHANGE_ME_ADMIN_USERNAME

# ---- 机密 ----

# 32 字节 base64。库里所有敏感配置都用它封：对象存储凭据、OTA 签名私钥、推送服务
# 账号、签名密钥外层、扫链端点。换掉它 = 那些配置全部解不开
STORAGE_MASTER_KEY=CHANGE_ME_STORAGE_MASTER_KEY

# 一行 DSN。格式是 go-sql-driver 的标准写法，参数含义见它的文档。
#
# 口令里含 @ / : & $ 都不用转义（驱动取最后一个 @ 作分隔），但**用户名**不能含 ':'。
# 时区写 UTC 不能写 Z：Z 是 ISO-8601 的记号，不是时区名，驱动不认。
#
# 没写的参数服务端会补成我们的默认值并在 `rn-server config` 里标出来——驱动自己的
# 默认值和我们的不一样（parseTime 默认 false、三个超时默认 0 = 永不超时），照着
# MySQL 文档随手写一行拿到的正是那两样，而它们要到运行时才发作。
#
# 值**必须**带引号。systemd 读 EnvironmentFile 时会把引号去掉，加不加对服务没区别；
# 但 `tcp(...)` 里的括号在 shell 里是语法错误，一旦有人 `set -a; . /etc/rn-foundation.env`
# （运维脚本里很常见），bash 会把这一整行连同口令原样打进终端，并且从这里起后面的键
# 一个都读不到。2026-09-13 的口令泄漏就是这么发生的。
MYSQL_DSN='CHANGE_ME_USER:CHANGE_ME_PASSWORD@tcp(CHANGE_ME_HOST:3306)/CHANGE_ME_DATABASE?parseTime=true&loc=UTC&charset=utf8mb4&timeout=15s&readTimeout=15s&writeTimeout=15s'

ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD_HASH=CHANGE_ME_ADMIN_PASSWORD_HASH
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# 构建机与签名闸不再用这里的共享令牌：每台机器在控制台「打包机与签名闸」新建时签发
# 自己的令牌（x-machine-token），只放在那台机器的 env 里，服务端只存 sha256（ADR 0019）。

# ---- 这台机器跑什么 ----

# 出站队列的认领是 CAS（status='pending' 时才抢到），多实例安全。
# 凭据**不在这里**：按租户存在库里，在管理端「Android 打包与签名」页配，
# 见 docs/decisions/0017-per-tenant-push-credentials.md
PUSH_DISPATCH_ENABLED=true

# 表结构由 rn-foundation-migrate 这个 oneshot unit 在启动前推进，服务进程自己不迁移。
# 两个写入方抢同一张 schema_migrations 是这里最不想要的东西
MYSQL_AUTO_MIGRATE=false

# ---- 与默认不同的调优。每一条都要有理由，没理由的删掉 ----

# 和别的进程共用同一个库，加起来别超过库那边的上限
MYSQL_CONNECTION_LIMIT=3
MYSQL_MAX_IDLE_CONNECTIONS=1
MYSQL_CONNECTION_MAX_LIFETIME_SECONDS=600
MYSQL_CONNECTION_MAX_IDLE_TIME_SECONDS=60

# proxy，**不要改成 direct**（2026-09-12 迁到 amos 时这份模板误写成 direct，
# 控制台上传当天就坏了，而服务端日志里一条都没有）。
#
# direct 是给浏览器签对象存储的直传地址，那一跳完全不经过我们，桶必须自己配了允许
# 控制台来源的跨域规则。我们用的这个桶**一条规则都没有**（六个来源全测过，一律 403
# AccessForbidden），而发布存储那把密钥对桶配置读写都是 AccessDenied——也就是说这件
# 事不是没做，是做不了。
#
# 坏掉的表现极难查：票据签发 201、curl 直接 PUT 200、签名和权限全对，只有浏览器传
# 不上去，界面上一句"无法连接对象存储"，服务端零日志。
#
# 哪天桶上真配好了跨域规则（GET /v1/admin/release-storage/cors 会算出该放行哪些来
# 源），再换回 direct 不迟。
ARTIFACT_UPLOAD_MODE=proxy

# ---- 下面这些**不用写**，列在这里只是为了说明"为什么它不在上面" ----
#
# CORS_ORIGINS          租户控制台的来源已由 tenant_domain 表推导，不必再列一遍。
#                       只有需要额外放行某个不在表里的来源时才写；生产上写 "*" 会
#                       被拒绝启动
# INDEXER_ENABLED       扫链是不是要跑，由起不起 rn-foundation-indexer 这个 unit
#                       决定。启一个 unit 再让它空转是给 Docker 防重启用的
# ANDROID_STORE_URL 等  下载地址按租户生成（/v1/public/releases/{id}/download），
#                       一个全局值不可能同时对四个租户都对。键已删除
# OTA_CHANNEL           租户配置里的 updatePolicy.otaChannel 就有值，兜底用不到。
#                       键已删除
# FCM_*                 推送凭据按租户进库了，见上面 PUSH_DISPATCH_ENABLED 处的说明
# DEVICE_IDENTITY_HMAC_KEY  留空即用 STORAGE_MASTER_KEY，一直是这么跑的
# 其余二十多个超时 / TTL / 会话参数  代码里的默认值就是我们要的值
