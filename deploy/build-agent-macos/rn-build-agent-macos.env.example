# /etc/rn-build-agent.env —— root:wheel 0600。launchd 的 plist 用 EnvironmentVariables 读它注入
# 控制进程（用户 _rnbuildagent）；执行进程（_rnbuilder）的环境是白名单构造的，这里只有
# 机器级工具变量会交给它。
#
# 设计：docs/design/ios-mac-builders-home-network-2026-09-18.md（§4.1 三个用户、§4.2 钥匙串、
# §4.3 上传账户、§4.5 装机清单）。Linux 构建机用的是 deploy/build-agent/ 下那一份。
#
# 只放启动项与这台机器的拓扑。值里有空格、括号、#、引号就加引号。

BUILD_AGENT_SERVER=https://api.anyfun.win
# 本机令牌（rnm_…）。由 `build-agent enroll`（install-macos.sh 调用）用控制台发的一次性注册码
# 换来后直接写进这里，不经过屏幕。不要贴进对话、工单、截图。
BUILD_AGENT_MACHINE_TOKEN=

BUILD_AGENT_REPO=/var/rn-build-agent/repos/rn-app.git
BUILD_AGENT_WORKSPACE=/var/rn-build-jobs
BUILD_AGENT_STATE_DIR=/var/rn-build-agent/state
BUILD_AGENT_SSH_KEY=/var/rn-build-agent/.ssh/id_ed25519
BUILD_AGENT_SSH_KNOWN_HOSTS=/opt/rn-build-agent/github_known_hosts

BUILD_AGENT_PLATFORMS=ios
# iOS 一次任务是 pnpm install + pod install + prebuild + archive + export + 上传几百 MB，
# 家用上行下 45 分钟太紧
BUILD_AGENT_TIMEOUT_MINUTES=120

# 执行进程：经 `sudo -n -u _rnbuilder /opt/rn-build-agent/build-runner` 启动
BUILD_AGENT_RUNNER=/opt/rn-build-agent/build-runner
BUILD_AGENT_RUNNER_USER=_rnbuilder

# 提交签名校验（必填，iOS 机器不配直接启动失败）。root 所有、控制进程改不了的允许签名者
# 文件；检出之后 `git verify-commit` 用它。没有它，服务端被攻破就能让这台机器构建任意提交，
# 而这台机器上放着全部租户的签名材料。
BUILD_AGENT_ALLOWED_SIGNERS=/opt/rn-build-agent/allowed_signers

# 签名材料目录（必填）。_rnbuilder 0700，装机时铺好，不随任务删：
#   rn-signing.keychain-db                        各 Team 的 Apple Distribution 证书 + 私钥
#   rn-signing.password                           钥匙串口令
#   profiles/<TEAMID>/<bundleId>.mobileprovision  各 App 的 App Store 描述文件
# 代理每次认领前盘点它，把"这台机器能签哪些 (Team, bundle id)"报给服务端。
RN_IOS_SIGNING_DIR=/var/rn-build-signing

# 上传 TestFlight。开着才调上传账户；关着照样出包，只是停在这台机器上由人去传。
BUILD_AGENT_IOS_UPLOAD=true
# 上传走**另一个用户**：执行进程一把 App Store Connect Key 都没有，控制进程也不读 Key，
# 它把核对过身份的 .ipa 交给 `sudo -n -u _rnuploader /opt/rn-build-agent/ios-upload`。
# 这样钥匙串里的签名材料在这台机器上没有出口：签得出包，传不上去。
BUILD_AGENT_IOS_UPLOADER=/opt/rn-build-agent/ios-upload
BUILD_AGENT_IOS_UPLOAD_USER=_rnuploader
# 每个 Team 一个子目录，里面是 key.json（issuerId / keyId）与 .p8，只有 _rnuploader 读得到。
# 控制进程只看目录在不在（进材料盘点），不读内容。
BUILD_AGENT_IOS_UPLOAD_KEYS=/var/rn-build-upload

# 空闲空间低于它就不认领，但仍然每 10 秒来报到（控制台显示"已暂停：磁盘不足"而不是"离线"）。
# 一次 iOS 任务要 1–2 GB 依赖 + 数 GB DerivedData。0 = 不检查。
BUILD_AGENT_MIN_FREE_GB=40

# 交给执行进程的机器级工具变量
PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin
LANG=en_US.UTF-8
