# 签名闸配置示例。复制成 /etc/rn-signer-a.env（或 -b），属主 root:rn-signer-a，权限 0640。
# 只放启动项；签名闸信什么（角色、受信构建机、确认过的租户与信任根、签过的版本号）只在
# 本机记录里，不在这里，也不在服务端。
#
# 值里有空格、括号、#、引号时必须加引号（systemd EnvironmentFile 会去掉引号）。

# 服务端源。与服务端同机（开发阶段 amos）时走本机端口，http 只允许回环地址。
SIGNER_SERVER_URL="http://127.0.0.1:13080"

# 本机令牌：控制台「平台维护 → 打包机与签名闸」新建这台机器时只显示一次。
# 不要贴进对话、工单、终端历史；在自己的终端里用 read -rsp 读入后写进文件。
SIGNER_MACHINE_TOKEN="rnm_REPLACE_WITH_THE_TOKEN_SHOWN_ONCE_IN_THE_CONSOLE"

# 控制台里登记的机器名，与本机记录的 genesis 绑定，改了就启动不了。
SIGNER_NAME="amos-signer-a"

# 状态目录与运行时目录，与 unit 里的 StateDirectory / RuntimeDirectory 一致。
# 运行时目录必须在 tmpfs 上（/run 是），否则签名闸拒绝启动：明文 keystore 不能落盘。
SIGNER_STATE_DIR="/var/lib/rn-signer-a"
SIGNER_RUNTIME_DIR="/run/rn-signer-a"

# JDK 与 build-tools：必须是 root 拥有、组与其它用户不可写的副本（签名闸启动时检查，
# JAVA_HOME 查整棵目录树与树里符号链接的目标）。不要指向构建机那份 Android SDK。
SIGNER_JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
SIGNER_BUILD_TOOLS_DIR="/opt/rn-signer/build-tools/35.0.0"

# 检查进程：生产用 socket（二选一必填）。SIGNER_CHECK_EXEC 只给本地测试用，没有 systemd 隔离。
SIGNER_CHECK_SOCKET="/run/rn-signer-a-check.sock"
# SIGNER_CHECK_EXEC="/opt/rn-signer/bin/signer-check"

# versionCode 上限：比已签最大值最多跳多少、绝对上限。只能在签名闸本机改。
SIGNER_MAX_VERSION_CODE_JUMP="100"
SIGNER_MAX_VERSION_CODE="10000000"
