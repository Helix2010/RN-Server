# 签名闸 @INSTANCE@ 的配置（模板）。install.sh 渲染成 /etc/rn-signer-@INSTANCE@.env，
# 属主 root:rn-signer-@INSTANCE@，权限 0640，然后执行 signer enroll。
#
# SIGNER_SERVER_URL、SIGNER_NAME、SIGNER_MACHINE_TOKEN 不在模板里：signer enroll 用注册码换回令牌后
# 原子替换这个文件，写入这三项（令牌不经过屏幕），其余行原样保留。
# 签名闸信什么（角色、受信签名闸与构建机、恢复公钥、确认过的租户、签过的版本号）只在本机记录里。

# 状态目录与运行时目录，与 unit 里的 StateDirectory / RuntimeDirectory 一致。
# signer enroll 按这里的状态目录生成本机密钥（目录不存在时创建，属主取本文件的属组同名用户）。
SIGNER_STATE_DIR="/var/lib/rn-signer-@INSTANCE@"
SIGNER_RUNTIME_DIR="/run/rn-signer-@INSTANCE@"

# JDK 与 build-tools：root 拥有、组与其它用户不可写的副本（签名闸启动时检查整棵 JAVA_HOME）。
# arm64 机器上是 /usr/lib/jvm/java-17-openjdk-arm64。
SIGNER_JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
SIGNER_BUILD_TOOLS_DIR="/opt/rn-signer/build-tools/35.0.0"

# 检查进程 socket（rn-signer-@INSTANCE@-check.socket 创建）。
SIGNER_CHECK_SOCKET="/run/rn-signer-@INSTANCE@-check.sock"

# versionCode 上限：比已签最大值最多跳多少、绝对上限。只能在签名闸本机改。
SIGNER_MAX_VERSION_CODE_JUMP="100"
SIGNER_MAX_VERSION_CODE="10000000"
