# 签名闸 A（开发阶段在 amos 上；主备角色写在它自己的本机记录里，不在这个文件里）。
#
# 只人工部署：二进制从审阅过的 tag 用固定工具链构建、sha256 记进离线记录、root 手工安装。
# rn-foundation-apply 与 CI 部署账号不得触及 rn-signer-* 的任何路径。步骤见 README.md。
#
# 目录：
#   /opt/rn-signer/bin/signer、signer-check      程序本体（root:root 0755）
#   /opt/rn-signer/build-tools/<版本>/lib/        root 拥有的 apksigner.jar 副本（不指向构建机的 SDK）
#   /etc/rn-signer-a.env                          配置（root:rn-signer-a 0640，含本机令牌）
#   /var/lib/rn-signer-a/                         状态：本机私钥、trust.jsonl、signed.jsonl（0700）
#   /run/rn-signer-a/                             运行时（tmpfs，0700）：明文 keystore 只出现在这里，签完即删
#   /run/rn-signer-a-check.sock                   检查进程 socket（rn-signer-a-check.socket 创建）
#
# 真正的边界是文件权限（其它系统用户读不到 0700 的状态目录）；下面的硬化是纵深防御。
[Unit]
Description=RN Android signing gate A
Documentation=file:///opt/rn-signer/README.md
Wants=network-online.target
After=network-online.target rn-signer-a-check.socket
Requires=rn-signer-a-check.socket

[Service]
Type=exec
User=rn-signer-a
Group=rn-signer-a
EnvironmentFile=/etc/rn-signer-a.env
ExecStart=/opt/rn-signer/bin/signer run
# 致命错误（本机记录校验失败、令牌被吊销、公钥不符）退出后不要高频重启刷日志
Restart=on-failure
RestartSec=60s
# SIGTERM 时签名闸把手上的任务 release 回服务端再退出（apksigner 最多几十秒）
TimeoutStopSec=90s
KillMode=mixed

StateDirectory=rn-signer-a
StateDirectoryMode=0700
RuntimeDirectory=rn-signer-a
RuntimeDirectoryMode=0700
# 进程退出时 systemd 删除运行时目录；签名闸启动时也会先清空它
RuntimeDirectoryPreserve=no

UMask=0077
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# 不设 MemoryDenyWriteExecute：JVM 的 JIT 需要可写可执行内存
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 只允许连 API。开发阶段与服务端同机，SIGNER_SERVER_URL=http://127.0.0.1:13080；
# 独立虚拟机上用 drop-in 改成 API 的地址与 DNS 解析器地址（见 README）。
IPAddressDeny=any
IPAddressAllow=localhost
# 可写路径只有 StateDirectory 与 RuntimeDirectory（ProtectSystem=strict 下自动放行）。
# 另一台签名闸、构建机、服务端的机密一律不可见（这些路径不存在时 "-" 前缀忽略）。
InaccessiblePaths=-/var/lib/rn-signer-b -/run/rn-signer-b -/etc/rn-signer-b.env
InaccessiblePaths=-/var/lib/rn-build-agent -/etc/rn-build-agent.env -/etc/rn-foundation.env

[Install]
WantedBy=multi-user.target
